# --- Build intermediates ---
*.d
*.o
*.lst
*.map
main
build/
cmake-build-*/

# --- Build outputs (device) ---
*.nro
*.nacp
*.elf
*.nsp
*.npdm
*.nso
*.flag
*.zip
*.exe
out/

# Generated by src/Makefile from git describe.
src/app/version.h

# --- Artefacts pulled down or produced by tools/devtools ---
# Logs, Atmosphere crash reports, HID dumps (*.dmp) and per-build archived binaries
# land in debug/. /log*.txt stays because older checkouts still have logs sitting
# in the repository root.
/debug/
/log*.txt
*.bin
*.dmp

# --- Tooling ---
# Personal permission allowlist. The skills under .claude/skills/ are
# shared; this file pre-approves writing to a console's SD card, so it
# stays local rather than being inherited by anyone who clones.
.claude/settings.local.json
__pycache__/
*.pyc
tools/*/out/
.vscode/ipch/
.vs/
.DS_Store
